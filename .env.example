# PostgreSQL — only used for the optional "Home Sync" of the Family Wall.
# Without it the site still works; the wall simply stays on each device.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional AI Santa. Leave these unset to use Santa's built-in letters (free, offline).
# Any OpenAI-compatible chat endpoint works. The key is only ever read on the server.
# SANTA_AI_API_KEY=
# SANTA_AI_MODEL=
# SANTA_AI_BASE_URL=https://api.openai.com/v1
